# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Required to sign and verify sessions. Generate a long random value.
JWT_SECRET="replace-with-a-long-random-secret"

# Required to encrypt uploaded candidate documents. This must be 64 hexadecimal characters.
# Keep the value backed up securely: changing it prevents reading existing documents.
ENCRYPTION_KEY="replace-with-64-hex-characters"

# Required only to enable the DB Explorer for the authorised owner account.
DB_EXPLORER_PASSWORD="replace-with-a-unique-long-password"

# Optional persistent location for encrypted uploads. Defaults to ./private_uploads.
# PRIVATE_UPLOADS_DIR="/var/lib/bail-bail/private_uploads"
