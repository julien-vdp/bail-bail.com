datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String?
  role         String   @default("OWNER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  properties Property[]
}

model Property {
  id           String   @id @default(uuid())
  code         String   @unique
  title        String
  shortAddress String
  rent               Float
  surface            Float
  description        String?
  status             String   @default("AVAILABLE") // AVAILABLE, RENTED, DRAFT
  isEligibleGLI      Boolean  @default(false)
  minSalaryRequired  Float?
  studentPolicy      String   @default("ACCEPTED") // ACCEPTED, REFUSED, ONLY_STUDENTS
  
  // Nouveaux paramètres dossier dynamique
  hasGli                      Boolean  @default(false)
  gliMonthlyIncomeThreshold  Float?
  acceptsGuarantor           Boolean  @default(true)
  acceptsStudent             Boolean  @default(true)
  requiresTaxNotice          Boolean  @default(true)
  requiresCurrentAddressProof Boolean  @default(true)
  requiresEmploymentProof    Boolean  @default(true)
  requiresIncomeProof        Boolean  @default(true)
  customInstructions         String?

  // Nouveaux paramètres moteur conditionnel GLI
  rentWithCharges             Float    @default(0.0)
  gliMode                     String   @default("NONE") // NONE, INDICATIVE, STRICT
  acceptsStudents             Boolean  @default(true)
  acceptsGuarantors           Boolean  @default(true)
  acceptsColocation           Boolean  @default(false)
  acceptsUnstableProfiles     Boolean  @default(false)
  tenantAlreadyInPlaceStatus  String   @default("NEW_TENANT") // NEW_TENANT, IN_PLACE_LESS_THAN_6_MONTHS, IN_PLACE_MORE_THAN_6_MONTHS
  customDocumentInstructions  String?
  
  ownerId            String?
  owner        User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  images       PropertyImage[]
  visitSlots   VisitSlot[]
  applications Application[]
}

model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  createdAt  DateTime @default(now())
}

model VisitSlot {
  id            String   @id @default(uuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  date          DateTime
  duration      Int      @default(30) // in minutes
  maxCandidates Int      @default(1) // Pour gérer le surbooking
  status        String   @default("AVAILABLE") // AVAILABLE, BOOKED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  applications Application[]
}

model Candidate {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  email        String   @unique
  phone        String
  passwordHash String?
  
  // Profil professionnel et ressources
  employmentStatus      String? // CDI, CDD, PUBLIC_SERVANT, SELF_EMPLOYED, RETIRED, STUDENT, UNEMPLOYED, OTHER
  hasGuarantor          Boolean  @default(false)
  declaredMonthlyIncome Float?

  // Nouveaux champs moteur conditionnel GLI
  isInProbationPeriod   Boolean?  @default(false)
  cddRemainingMonths    Int?
  selfEmployedYears     Float?
  isStudentOrApprentice Boolean?  @default(false)
  isColocation          Boolean   @default(false)
  isApprentice          Boolean?  @default(false)
  roommatesCount        Int?      @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applications Application[]
  guarantor    Guarantor?
  roommates    Roommate[]
}

model Guarantor {
  id                    String    @id @default(uuid())
  candidateId           String    @unique
  candidate             Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  firstName             String
  lastName              String
  employmentStatus      String?
  declaredMonthlyIncome Float?
  fiscalResidenceInFrance Boolean  @default(true)
}

model Roommate {
  id                    String    @id @default(uuid())
  candidateId           String
  candidate             Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  firstName             String
  lastName              String
  employmentStatus      String?
  declaredMonthlyIncome Float?
}

model Application {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status      String   @default("NOUVEAU") // NOUVEAU, INCOMPLET, EN_COURS, ACCEPTE, REFUSE
  hasAcceptedConditions Boolean @default(false)
  isStudent   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents            Document[]
  visitSlots           VisitSlot[]
  auditLogs            AuditLog[]
  documentRequirements DocumentRequirement[]
}

model DocumentRequirement {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  key           String
  label         String
  description   String
  category      String
  required      Boolean     @default(true)
  recommended   Boolean     @default(false)
  appliesTo     String      @default("candidate") // candidate, guarantor, roommate
  status        String      @default("PENDING")   // PENDING, UPLOADED, VALIDATED, REJECTED
  maxFiles      Int         @default(1)
  
  documents     Document[]
}

model Document {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          String      // ID_CARD, INCOME, EMPLOYMENT, TAX, RESIDENCE, GUARANTOR
  filePath      String
  fileName      String
  mimeType      String
  size          Int
  status        String      @default("PENDING") // PENDING, VALIDATED, REJECTED
  rejectionReason String?
  expiresAt     DateTime?
  createdAt     DateTime    @default(now())

  // Validation candidat
  candidateApproved Boolean   @default(false)
  candidateComment  String?

  requirementId     String?
  requirement       DocumentRequirement? @relation(fields: [requirementId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  action        String
  details       String?
  createdAt     DateTime    @default(now())
}
